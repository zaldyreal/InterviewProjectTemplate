{
  "ConnectionStrings": {
    "MySQLConnectionString": "Server=mysql-db;Port=3306;Database=moodtrackerdb;Uid=app;Pwd=password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MoodTracker": {
    "TimeZone": "Australia/Melbourne",
    "UserKeyCookieName": "mood_tracker_user",
    "UserKeyCookieDays": 365,
    "UseSecureCookies": false
  },
  "AdminAuth": {
    "Issuer": "MoodTracker",
    "Audience": "MoodTrackerAdmin",
    "TokenLifetimeMinutes": 60,
    "SeedUsername": "admin"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
